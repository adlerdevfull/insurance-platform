APP_ENV=dev
APP_SECRET=insurance_secret_key_change_in_prod
APP_DEBUG=true

DATABASE_URL="mysql://insurance:insurance@mysql:3306/insurance_db?serverVersion=8.0&charset=utf8mb4"

REDIS_URL=redis://redis:6379

RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=insurance_jwt_passphrase
JWT_TTL=3600

# Generate locally with: php bin/console lexik:jwt:generate-keypair
# Never commit config/jwt/private.pem or reuse portfolio keys.
